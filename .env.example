# =============================================================================
# AVA configuration. Copy to .env and fill in the REQUIRED values.
#   cp .env.example .env        (or run scripts/setup.sh, which generates secrets)
# Never commit .env. Never put real secrets in this file.
# =============================================================================

# --- Identity ------------------------------------------------------------------
# Assistant name is provisional; it can also be changed later in Settings.
AVA_NAME=AVA
OFFICE_NAME="Architecture Office"
# Internal hostname served by the reverse proxy (needs an internal DNS record).
AVA_HOSTNAME=ava.office.local
# LAN address of the server to bind 80/443 to (0.0.0.0 = all interfaces).
AVA_BIND_ADDRESS=0.0.0.0
OFFICE_TIMEZONE=America/Puerto_Rico

# --- Runtime -------------------------------------------------------------------
# development | test | production
APP_ENV=production
# Demo data can only be loaded when DEMO_MODE=true and APP_ENV is not production.
DEMO_MODE=false
LOG_LEVEL=INFO

# --- REQUIRED secrets ------------------------------------------------------------
# Generate with: openssl rand -base64 48
SECRET_KEY=
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=

# --- TLS -----------------------------------------------------------------------
# "internal" = Caddy internal CA (install its root cert on office devices), or
# "/certs/ava.crt /certs/ava.key" = certificate issued by the office CA.
AVA_TLS=internal

# --- Privacy / AI ----------------------------------------------------------------
# true: office data is never sent to external AI services; the AI endpoint must be
# on this machine or the private network (enforced by the application).
STRICT_LOCAL_MODE=true
# ollama | vllm | none   ("cloud" is refused while STRICT_LOCAL_MODE=true)
AI_PROVIDER=ollama
# Docker service (compose --profile local-ai) or another LAN server, e.g. http://192.168.1.50:11434
AI_BASE_URL=http://ollama:11434
# Choose after checking hardware (docs/AI.md). CPU-only servers: a 7-8B Q4 model.
AI_MODEL=llama3.1:8b-instruct-q4_K_M
AI_TIMEOUT_SECONDS=120
EMBEDDING_MODEL=nomic-embed-text
# Only used if an administrator deliberately disables STRICT_LOCAL_MODE.
CLOUD_AI_API_KEY=

# --- Backups -----------------------------------------------------------------------
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30

# --- Integrations (Phase 2+; not used yet) --------------------------------------
# DROPBOX_APP_KEY=
# DROPBOX_APP_SECRET=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
